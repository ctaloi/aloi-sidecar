#!/usr/bin/env python3
"""Today's Microsoft 365 meetings for the Aloi Sidecar bar widget and engine.

  aloi-meetings status            {"signedIn": bool, "account": "..."}
  aloi-meetings login             sign in through the browser (auth code + PKCE)
  aloi-meetings today             today's meetings, as JSON
  aloi-meetings logout            forget the sign-in
  aloi-meetings parse             a Graph calendarView reply on stdin, as today's JSON (tests)

Options: --client-id ID  --tenant ID  (also ALOI_MEETINGS_CLIENT_ID / _TENANT)

Every command prints one JSON object. A failure prints {"error": kind,
"detail": text}, where kind is "signin", "consent", "offline", "keyring" or
"other", and exits non-zero, so the shell can say what's wrong in a word.

The refresh token lives in the desktop keyring (Secret Service, through
secret-tool). This plugin keeps its own sign-in, separate from vmail's,
because two apps sharing one rotating refresh token log each other out.
"""

import base64
import contextlib
import datetime as dt
import fcntl
import hashlib
import html
import http.server
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request

# "Aloi vmail", the Vaspian app registration shared by vmail, vteams and
# these plugins: a public client with delegated mail, calendar and chat access.
DEFAULT_CLIENT_ID = "367e59f5-6cf7-48c7-89e4-21021559a333"
DEFAULT_TENANT = "bab5c5fb-b019-47ba-b72d-0874689da097"
SCOPES = "https://graph.microsoft.com/Calendars.Read https://graph.microsoft.com/User.Read offline_access openid profile"
GRAPH = "https://graph.microsoft.com/v1.0"
SELECT = ",".join([
    "subject", "start", "end", "isAllDay", "isCancelled", "showAs", "responseStatus",
    "location", "organizer", "isOrganizer", "onlineMeeting", "onlineMeetingUrl",
    "onlineMeetingProvider", "isOnlineMeeting", "webLink", "body", "sensitivity", "attendees",
])
LOGIN_TIMEOUT = 300
HTTP_TIMEOUT = 20

KEYRING = ["service", "aloi-meetings", "kind", "refresh-token"]
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "aloi-meetings")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "aloi-meetings")


class Failure(Exception):
    def __init__(self, kind, detail=""):
        super().__init__(detail)
        self.kind = kind
        self.detail = detail


EXIT = {"signin": 2, "consent": 3, "offline": 4, "keyring": 5, "other": 1}


def emit(obj, code=0):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()
    sys.exit(code)


# ---------- settings and local state ----------

def options(argv):
    opts = {
        "client_id": os.environ.get("ALOI_MEETINGS_CLIENT_ID") or DEFAULT_CLIENT_ID,
        "tenant": os.environ.get("ALOI_MEETINGS_TENANT") or DEFAULT_TENANT,
    }
    rest = []
    it = iter(argv)
    for arg in it:
        if arg in ("--client-id", "--tenant"):
            value = next(it, "").strip()
            if value:
                opts[arg[2:].replace("-", "_")] = value
        else:
            rest.append(arg)
    for key in ("client_id", "tenant"):
        if not re.fullmatch(r"[A-Za-z0-9.-]{1,128}", opts[key]):
            raise Failure("other", f"{key} doesn't look right: {opts[key]}")
    return opts, rest


def private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if st.st_uid != os.getuid() or os.path.islink(path):
        raise Failure("other", f"unsafe directory: {path}")
    return path


def write_private(path, text):
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


@contextlib.contextmanager
def token_lock():
    # One refresh at a time: Entra rotates the refresh token on each use.
    fd = os.open(os.path.join(private_dir(RUNTIME), "lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


# ---------- keyring ----------

def keyring_available():
    return shutil.which("secret-tool") is not None


def keyring_get():
    if not keyring_available():
        raise Failure("keyring", "secret-tool isn't installed")
    r = subprocess.run(["secret-tool", "lookup", *KEYRING], capture_output=True, text=True)
    if r.returncode != 0:
        if r.stderr.strip():
            raise Failure("keyring", r.stderr.strip())
        return ""
    return r.stdout.strip()


def keyring_put(token):
    if not keyring_available():
        raise Failure("keyring", "secret-tool isn't installed")
    r = subprocess.run(["secret-tool", "store", "--label=Aloi Sidecar", *KEYRING],
                       input=token, capture_output=True, text=True)
    if r.returncode != 0:
        raise Failure("keyring", r.stderr.strip() or "couldn't save to the keyring")


def keyring_clear():
    if keyring_available():
        subprocess.run(["secret-tool", "clear", *KEYRING], capture_output=True)


# ---------- Microsoft identity ----------

def endpoint(opts, name):
    return f"https://login.microsoftonline.com/{opts['tenant']}/oauth2/v2.0/{name}"


def explain(code, description):
    """Sort an identity error into signin / consent / other."""
    first = (description or "").splitlines()[0] if description else ""
    if code in ("invalid_grant", "interaction_required", "login_required") or "AADSTS700082" in first:
        return Failure("signin", first or code)
    if code in ("consent_required", "invalid_scope") or any(c in first for c in ("AADSTS65001", "AADSTS65004", "AADSTS90094", "AADSTS650057")):
        return Failure("consent", first or code)
    return Failure("other", first or code)


def post_form(url, form):
    data = urllib.parse.urlencode(form).encode()
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            body = json.load(e)
        except ValueError:
            raise Failure("other", f"sign-in server said {e.code}")
        raise explain(body.get("error", ""), body.get("error_description", ""))
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise Failure("offline", str(getattr(e, "reason", e)))


def account_from(id_token):
    try:
        payload = id_token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        return claims.get("preferred_username") or claims.get("email") or claims.get("name") or ""
    except (IndexError, ValueError):
        return ""


def save_tokens(reply, account=None):
    if reply.get("refresh_token"):
        keyring_put(reply["refresh_token"])
    expires = dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=int(reply.get("expires_in", 3600)) - 120)
    write_private(os.path.join(private_dir(RUNTIME), "access.json"),
                  json.dumps({"token": reply["access_token"], "expires": expires.isoformat()}))
    if account is None:
        account = account_from(reply.get("id_token", ""))
    if account:
        write_private(os.path.join(private_dir(STATE), "account.json"), json.dumps({"account": account}))


def access_token(opts):
    with token_lock():
        cached = read_json(os.path.join(RUNTIME, "access.json"))
        try:
            if cached and dt.datetime.fromisoformat(cached["expires"]) > dt.datetime.now(dt.timezone.utc):
                return cached["token"]
        except (KeyError, ValueError):
            pass
        refresh = keyring_get()
        if not refresh:
            raise Failure("signin", "not signed in")
        reply = post_form(endpoint(opts, "token"), {
            "client_id": opts["client_id"], "grant_type": "refresh_token",
            "refresh_token": refresh, "scope": SCOPES,
        })
        save_tokens(reply)
        return reply["access_token"]


def login(opts):
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(24)
    result = {}
    done = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            get = lambda k: (q.get(k) or [""])[0]
            if not (get("code") or get("error")):
                self.send_error(404)
                return
            if get("error"):
                result["error"] = explain(get("error"), get("error_description"))
            elif get("state") != state:
                result["error"] = Failure("other", "the sign-in reply didn't match this request")
            else:
                result["code"] = get("code")
            ok = "code" in result
            page = PAGE.format(
                title="You're signed in" if ok else "Sign-in didn't finish",
                body="Aloi Sidecar can see your calendar now. You can close this tab."
                if ok else html.escape(result["error"].detail or "Try again from the bar."))
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(page.encode())
            done.set()

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect = f"http://localhost:{server.server_port}"
    query = {
        "client_id": opts["client_id"], "response_type": "code", "redirect_uri": redirect,
        "response_mode": "query", "scope": SCOPES, "state": state,
        "code_challenge": challenge, "code_challenge_method": "S256", "prompt": "select_account",
    }
    hint = read_json(os.path.join(STATE, "account.json")).get("account")
    if hint:
        query["login_hint"] = hint
    url = endpoint(opts, "authorize") + "?" + urllib.parse.urlencode(query)

    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        raise Failure("other", "couldn't open the browser")
    finished = done.wait(LOGIN_TIMEOUT)
    server.shutdown()
    if not finished:
        raise Failure("signin", "sign-in timed out")
    if "error" in result:
        raise result["error"]

    reply = post_form(endpoint(opts, "token"), {
        "client_id": opts["client_id"], "grant_type": "authorization_code", "code": result["code"],
        "redirect_uri": redirect, "code_verifier": verifier, "scope": SCOPES,
    })
    if not reply.get("refresh_token"):
        raise Failure("other", "Microsoft didn't return a refresh token")
    with token_lock():
        save_tokens(reply)
    return {"signedIn": True, "account": read_json(os.path.join(STATE, "account.json")).get("account", "")}


PAGE = """<!doctype html><meta charset="utf-8"><title>Aloi Sidecar</title>
<style>body{{font:16px system-ui,sans-serif;display:grid;place-items:center;height:90vh;margin:0;color:#ddd;background:#1c1c1c}}
main{{max-width:28em;text-align:center}}h1{{font-size:1.4em;font-weight:600}}p{{color:#aaa}}</style>
<main><h1>{title}</h1><p>{body}</p></main>"""


# ---------- Graph ----------

def forget_access_token():
    with contextlib.suppress(OSError):
        os.remove(os.path.join(RUNTIME, "access.json"))


def graph_get(opts, url, retried=False):
    token = access_token(opts)
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Prefer": 'outlook.timezone="UTC", outlook.body-content-type="text"',
    })
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            # The cached access token went stale early (revoked, or the clock
            # jumped). The refresh token may still be good: try it once, and
            # only ask to sign in again if that fails too.
            forget_access_token()
            if not retried:
                return graph_get(opts, url, retried=True)
            raise Failure("signin", "Microsoft asked to sign in again")
        if e.code == 403:
            raise Failure("consent", "the app isn't allowed to read your calendar")
        raise Failure("other", f"Microsoft Graph said {e.code}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise Failure("offline", str(getattr(e, "reason", e)))


def local_day(day=None):
    """Midnight to midnight in the local zone, as UTC instants."""
    today = day or dt.date.today()
    start = dt.datetime.combine(today, dt.time.min).astimezone()
    end = dt.datetime.combine(today + dt.timedelta(days=1), dt.time.min).astimezone()
    return today, start.astimezone(dt.timezone.utc), end.astimezone(dt.timezone.utc)


def today(opts, day=None):
    date, start, end = local_day(day)
    query = urllib.parse.urlencode({
        "startDateTime": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "endDateTime": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "$select": SELECT, "$orderby": "start/dateTime", "$top": "100",
    })
    url, values = f"{GRAPH}/me/calendarView?{query}", []
    for _ in range(10):
        page = graph_get(opts, url)
        values.extend(page.get("value", []))
        url = page.get("@odata.nextLink")
        if not url:
            break
    return shape(values, date)


# ---------- turning Graph events into what the bar needs ----------

JOIN = re.compile(
    r"https://(?:"
    r"teams\.microsoft\.com/l/meetup-join/[^\s\"'<>]+"
    r"|teams\.microsoft\.com/meet/[^\s\"'<>]+"
    r"|teams\.live\.com/meet/[^\s\"'<>]+"
    r"|[a-z0-9.-]*zoom\.us/(?:j|my|w|s)/[^\s\"'<>]+"
    r"|meet\.google\.com/[a-z]{3}-[a-z]{4}-[a-z]{3}[^\s\"'<>]*"
    r"|[a-z0-9.-]*webex\.com/[^\s\"'<>]+"
    r"|meet\.goto\.com/[^\s\"'<>]+"
    r"|global\.gotomeeting\.com/join/[^\s\"'<>]+"
    r")", re.I)
# Locations that only restate that there's a link; the Join button says it.
PLACEHOLDER_LOCATIONS = {"microsoft teams meeting", "microsoft teams", "teams meeting", "zoom", "zoom meeting", "google meet"}
SAFELINK = re.compile(r"https://[a-z0-9.]*safelinks\.protection\.outlook\.com/\?[^\s\"'<>]+", re.I)


def unwrap_safelinks(text):
    def real(m):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(m.group(0)).query)
        return (q.get("url") or [m.group(0)])[0]
    return SAFELINK.sub(real, text)


def find_join_url(text):
    if not text:
        return ""
    text = unwrap_safelinks(html.unescape(text))
    m = JOIN.search(text)
    return m.group(0).rstrip(".,);]>") if m else ""


# Exchange names zones the Windows way; these are the ones it sends most.
WINDOWS_ZONES = {
    "Eastern Standard Time": "America/New_York", "Central Standard Time": "America/Chicago",
    "Mountain Standard Time": "America/Denver", "US Mountain Standard Time": "America/Phoenix",
    "Pacific Standard Time": "America/Los_Angeles", "Alaskan Standard Time": "America/Anchorage",
    "Hawaiian Standard Time": "Pacific/Honolulu", "Atlantic Standard Time": "America/Halifax",
    "GMT Standard Time": "Europe/London", "W. Europe Standard Time": "Europe/Berlin",
    "Romance Standard Time": "Europe/Paris", "Central Europe Standard Time": "Europe/Budapest",
    "India Standard Time": "Asia/Kolkata", "China Standard Time": "Asia/Shanghai",
    "Tokyo Standard Time": "Asia/Tokyo", "AUS Eastern Standard Time": "Australia/Sydney",
}


def zone(name):
    if not name or name.upper() in ("UTC", "COORDINATED UNIVERSAL TIME", "TZONE://MICROSOFT/UTC"):
        return dt.timezone.utc
    try:
        from zoneinfo import ZoneInfo
        return ZoneInfo(WINDOWS_ZONES.get(name, name))
    except (ImportError, ValueError, KeyError, OSError):
        return dt.timezone.utc


def utc_iso(when):
    """Graph's dateTimeTimeZone as a UTC ISO instant. We ask for UTC, but a
    reply can still carry the event's own zone, so honor whatever it says."""
    value = (when or {}).get("dateTime", "")
    if not value:
        return ""
    try:
        parsed = dt.datetime.fromisoformat(value.split(".")[0])
    except ValueError:
        return ""
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=zone((when or {}).get("timeZone", "")))
    return parsed.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def shape_event(g):
    online = g.get("onlineMeeting") or {}
    location = (g.get("location") or {}).get("displayName", "") or ""
    body = (g.get("body") or {}).get("content", "") or ""
    join = online.get("joinUrl") or g.get("onlineMeetingUrl") or find_join_url(location) or find_join_url(body)
    organizer = ((g.get("organizer") or {}).get("emailAddress") or {})
    private = g.get("sensitivity") in ("private", "confidential") and not g.get("subject")
    return {
        "id": g.get("id", ""),
        "subject": (g.get("subject") or "").strip(),
        "start": utc_iso(g.get("start")),
        "end": utc_iso(g.get("end")),
        "allDay": bool(g.get("isAllDay")),
        "cancelled": bool(g.get("isCancelled")) or (g.get("subject") or "").startswith("Canceled: "),
        "showAs": (g.get("showAs") or "").lower(),
        "response": ((g.get("responseStatus") or {}).get("response") or "").lower(),
        "isOrganizer": bool(g.get("isOrganizer")),
        "organizer": organizer.get("name") or organizer.get("address") or "",
        "location": "" if JOIN.fullmatch(location.strip()) or location.strip().lower() in PLACEHOLDER_LOCATIONS else location.strip(),
        "joinUrl": join,
        "provider": (g.get("onlineMeetingProvider") or "").lower(),
        "webLink": g.get("webLink", ""),
        "private": private,
        # Who's invited (rooms left out), for Aloi Sidecar's notes on the meeting.
        "attendees": [{"name": a.get("emailAddress", {}).get("name") or a.get("emailAddress", {}).get("address", ""),
                       "email": a.get("emailAddress", {}).get("address", "")}
                      for a in g.get("attendees") or [] if a.get("type") != "resource"],
    }


def shape(values, date):
    events = [shape_event(g) for g in values]
    events = [e for e in events if e["start"] and e["end"]]
    events.sort(key=lambda e: (e["start"], e["end"]))
    return {
        "day": date.isoformat(),
        "fetched": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "events": events,
    }


# ---------- commands ----------

def main(argv):
    try:
        opts, rest = options(argv)
        cmd = rest[0] if rest else "today"
        if cmd == "status":
            account = read_json(os.path.join(STATE, "account.json")).get("account", "")
            emit({"signedIn": bool(keyring_get()), "account": account})
        elif cmd == "login":
            emit(login(opts))
        elif cmd == "today":
            day = dt.date.fromisoformat(rest[1]) if len(rest) > 1 else None
            emit(today(opts, day))
        elif cmd == "logout":
            keyring_clear()
            forget_access_token()
            emit({"signedIn": False})
        elif cmd == "parse":
            day = dt.date.fromisoformat(rest[1]) if len(rest) > 1 else dt.date.today()
            emit(shape(json.load(sys.stdin).get("value", []), day))
        else:
            raise Failure("other", f"unknown command: {cmd}")
    except Failure as f:
        emit({"error": f.kind, "detail": f.detail}, EXIT.get(f.kind, 1))
    except ValueError as e:
        emit({"error": "other", "detail": str(e)}, 1)


if __name__ == "__main__":
    main(sys.argv[1:])
