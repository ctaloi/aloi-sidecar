# Every app here carries the aloi- prefix: bare names get replaced by AUR
# packages of the same name on update.
pkgname=aloi-sidecar
pkgver=0.2.0
pkgrel=1
pkgdesc='A live transcript of your meeting, and an agent to ask about it'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('claude-code: the agent panel')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/aloi-sidecar "$pkgdir/usr/bin/aloi-sidecar"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/aloi-sidecar.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aloi-sidecar.svg"
  install -Dm644 "$startdir/aloi-sidecar.desktop" "$pkgdir/usr/share/applications/aloi-sidecar.desktop"
}
